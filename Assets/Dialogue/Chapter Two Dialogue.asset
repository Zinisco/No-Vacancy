  m_Script: {fileID: 11500000, guid: d22778bf57e3fca41942264a944f8db6, type: 3}
  m_Name: Chapter Two Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - text: The inspector called. Told me the Elevator is all set. Was this you?
    voiceClip: {fileID: 0}
  - text: 'If that''s the case. Then, it''s good to have you back in town.   '
    voiceClip: {fileID: 0}
  - text: Your Mother will be so excited to hear that you took it under your wing.
    voiceClip: {fileID: 0}
  - text: 'Careful of the second floor. Many of the balconies were left unstable.
      Best to keep those rooms closed off for now. '
    voiceClip: {fileID: 0}
  - text: 'I know your busy now, but it would be great to hear your voice. You don''t
      have to stop by the house, but it would be nice to receive a call from you
      whenever you get the chance. '
    voiceClip: {fileID: 0}
  - text: Good luck. We're rooting for you.
    voiceClip: {fileID: 0}
